<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Merrittocracy Autopilot — RSS Feed Check
    Polls Substack RSS every 15 minutes for new posts.
    Secrets loaded from macOS Keychain via autopilot-env.sh.

    Installation:
      1. Copy this file to ~/Library/LaunchAgents/
      2. Load: launchctl load ~/Library/LaunchAgents/com.merrittocratic.autopilot.check.plist
      3. Verify: launchctl list | grep merrittocratic
  -->

  <key>Label</key>
  <string>com.merrittocratic.autopilot.check</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/merrittocracyclaw/autopilot/scripts/autopilot-env.sh</string>
    <string>/opt/homebrew/bin/Rscript</string>
    <string>/Users/merrittocracyclaw/autopilot/run_distribution.R</string>
    <string>--check</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/merrittocracyclaw/autopilot</string>

  <!-- Run every 900 seconds (15 minutes) -->
  <key>StartInterval</key>
  <integer>900</integer>

  <!-- Log stdout and stderr -->
  <key>StandardOutPath</key>
  <string>/Users/merrittocracyclaw/autopilot/logs/launchd_check_stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/merrittocracyclaw/autopilot/logs/launchd_check_stderr.log</string>

  <key>KeepAlive</key>
  <false/>

  <key>LowPriorityIO</key>
  <true/>
</dict>
</plist>
