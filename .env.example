# Merrittocracy Autopilot — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to git.

ANTHROPIC_API_KEY=sk-ant-your-key-here

X_API_KEY=your-api-key
X_API_SECRET=your-api-secret
X_ACCESS_TOKEN=your-access-token
X_ACCESS_SECRET=your-access-secret
X_BEARER_TOKEN=your-bearer-token

REVIEW_SHEET_ID=your-sheet-id-here

# Zernio (LinkedIn posting) — key from zernio.com Settings -> API Keys,
# account id from the connected LinkedIn account in the Zernio dashboard
ZERNIO_API_KEY=sk_your-zernio-key
ZERNIO_LINKEDIN_ACCOUNT_ID=your-linkedin-account-id
